# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/centros_acopio?schema=public"

# Secret for signing JWT session cookies (min 32 chars). Generate: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-min-32"

# Solo para servir por HTTP plano (demo en red local / Docker). Omitir en HTTPS.
# COOKIE_SECURE=false

# Conexión directa sin pooler (Neon/Vercel la inyecta). En local = DATABASE_URL
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/centros_acopio?schema=public"
