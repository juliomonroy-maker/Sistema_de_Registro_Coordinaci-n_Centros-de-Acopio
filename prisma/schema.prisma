// Sistema de Registro y Coordinación de Centros de Acopio
// Modelo alineado a INSTRUCCIONES_PROYECTO.md: ledger de Movimientos,
// stock derivado, campañas, instituciones receptoras y 5 roles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon: conexión directa (sin pooler) para migraciones
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────────────  Enums  ──────────────────────────────────────

enum Rol {
  COORDINADOR // coordinador general: registra centros/campañas, ve todo
  ENCARGADO // encargado de centro: registra todos los movimientos de su centro
  VOLUNTARIO // apoya recepciones y entregas; NO merma ni ajuste ni config
  INSTITUCION // institución receptora: ve y confirma entregas canalizadas
  LIDER_CAMPANA // opcional: gestiona una campaña y ve su dashboard agregado
}

enum CategoriaArticulo {
  NO_PERECEDERO
  PERECEDERO
  ROPA
  LIMPIEZA
  MEDICAMENTO
  OTRO
}

enum Unidad {
  PIEZA
  KG
  L
  BOLSA
  CAJA
}

enum TipoMovimiento {
  RECEPCION // entrada por donación
  ENTREGA // salida hacia institución/beneficiario
  MERMA // salida por pérdida (requiere motivo)
  TRANSFERENCIA_SALIDA // salida hacia otro centro (ligada)
  TRANSFERENCIA_ENTRADA // entrada desde otro centro (ligada)
  AJUSTE // corrección manual +/- (requiere motivo)
}

enum Motivo {
  CADUCIDAD
  DANO
  PERDIDA
  CORRECCION
  OTRO
}

// Estado de aprobación de un movimiento. Solo APROBADO cuenta para el stock.
// Hoy aplica a MERMA solicitada por un encargado (la aprueba el coordinador);
// el resto de movimientos nacen APROBADO.
enum EstadoMovimiento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Estado de aprobación de una cuenta. Voluntarios que se registran solos
// nacen PENDIENTE y no pueden iniciar sesión hasta que el encargado de su
// centro o el coordinador los apruebe.
enum EstadoUsuario {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ───────────────────────────────  Usuarios  ───────────────────────────────────

model Usuario {
  id           String       @id @default(cuid())
  nombre       String
  email        String       @unique
  passwordHash String
  rol          Rol          @default(VOLUNTARIO)
  activo       Boolean      @default(true)
  // Aprobación de cuenta (registro público de voluntarios)
  estado        EstadoUsuario @default(APROBADO)
  aprobadoPorId String?
  aprobadoPor   Usuario?      @relation("UsuarioAprobador", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  aprobadoAt    DateTime?
  // Encargado/voluntario pertenecen a un centro
  centroId     String?
  centro       Centro?      @relation("CentroMiembros", fields: [centroId], references: [id], onDelete: SetNull)
  // Usuario de tipo institución receptora
  institucionId String?
  institucion  Institucion? @relation(fields: [institucionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  movimientos         Movimiento[] @relation("MovimientoActor")
  movimientosResueltos Movimiento[] @relation("MovimientoAprobador")
  usuariosAprobados   Usuario[]    @relation("UsuarioAprobador")
  centrosACargo       Centro[]     @relation("CentroEncargado")
  campanasLideradas   Campana[]    @relation("CampanaLider")

  @@index([centroId])
  @@index([institucionId])
  @@index([estado])
}

// ───────────────────────────────  Campañas  ───────────────────────────────────

model Campana {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  meta        String? // meta u objetivo de la campaña (texto libre)
  activa      Boolean   @default(true)
  liderId     String?
  lider       Usuario?  @relation("CampanaLider", fields: [liderId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  centros     CentroCampana[]
  movimientos Movimiento[]
  metas       MetaCampana[]

  @@index([activa])
}

// Meta cuantitativa por artículo: cuánto se espera RECIBIR (donaciones) en la campaña.
// El avance se deriva del ledger (suma de RECEPCION del artículo en la campaña).
model MetaCampana {
  id               String   @id @default(cuid())
  campanaId        String
  campana          Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  articuloId       String
  articulo         Articulo @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  cantidadObjetivo Float // > 0, en la unidad del artículo
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([campanaId, articuloId])
  @@index([campanaId])
}

// ───────────────────────────────  Centros  ────────────────────────────────────

model Centro {
  id          String   @id @default(cuid())
  nombre      String
  institucion String? // organización que opera el centro (texto)
  direccion   String
  ciudad      String
  estado      String
  latitud     Float?
  longitud    Float?
  telefono    String?
  encargadoId String?
  encargado   Usuario? @relation("CentroEncargado", fields: [encargadoId], references: [id], onDelete: SetNull)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  miembros              Usuario[]       @relation("CentroMiembros")
  campanas              CentroCampana[]
  movimientos           Movimiento[]    @relation("MovimientoCentro")
  transferenciasEntrantes Movimiento[]  @relation("MovimientoCentroDestino")

  @@index([activo])
  @@index([ciudad])
}

// Centros participantes por campaña (N:M)
model CentroCampana {
  centroId  String
  centro    Centro  @relation(fields: [centroId], references: [id], onDelete: Cascade)
  campanaId String
  campana   Campana @relation(fields: [campanaId], references: [id], onDelete: Cascade)

  @@id([centroId, campanaId])
  @@index([campanaId])
}

// ────────────────────────  Instituciones receptoras  ──────────────────────────

model Institucion {
  id        String   @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  direccion String?
  createdAt DateTime @default(now())

  usuarios Usuario[]
  entregas Movimiento[] @relation("MovimientoInstitucion")
}

// ───────────────────────────────  Artículos  ──────────────────────────────────

model Articulo {
  id        String            @id @default(cuid())
  nombre    String
  categoria CategoriaArticulo
  unidad    Unidad
  createdAt DateTime          @default(now())

  movimientos Movimiento[]
  metas       MetaCampana[]

  @@unique([nombre, categoria, unidad])
  @@index([categoria])
}

// ───────────────  Movimientos (ledger único; stock derivado)  ──────────────────

model Movimiento {
  id         String         @id @default(cuid())
  tipo       TipoMovimiento
  centroId   String
  centro     Centro         @relation("MovimientoCentro", fields: [centroId], references: [id], onDelete: Cascade)
  campanaId  String
  campana    Campana        @relation(fields: [campanaId], references: [id], onDelete: Restrict)
  articuloId String
  articulo   Articulo       @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad   Float // siempre > 0; el signo lo determina el tipo (y signoPositivo en AJUSTE)
  signoPositivo Boolean     @default(true) // solo relevante en AJUSTE: true suma, false resta
  fecha      DateTime       @default(now())
  motivo     Motivo? // obligatorio en MERMA y AJUSTE
  nota       String?

  // Actor: quién registró el movimiento (trazabilidad)
  actorId String?
  actor   Usuario? @relation("MovimientoActor", fields: [actorId], references: [id], onDelete: SetNull)

  // Aprobación (MERMA solicitada por encargado → coordinador aprueba/rechaza).
  // Solo los movimientos APROBADO suman al stock.
  estado        EstadoMovimiento @default(APROBADO)
  aprobadoPorId String?
  aprobadoPor   Usuario?         @relation("MovimientoAprobador", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  resueltoAt    DateTime?
  motivoRechazo String?

  // RECEPCION: datos del donante (opcional / anónimo)
  donanteNombre  String?
  donanteAnonimo Boolean @default(false)

  // ENTREGA: institución receptora y confirmación
  institucionId      String?
  institucion        Institucion? @relation("MovimientoInstitucion", fields: [institucionId], references: [id], onDelete: SetNull)
  confirmadaRecibida Boolean      @default(false)
  confirmadaAt       DateTime?

  // TRANSFERENCIA: liga salida+entrada (mismo grupoTransferencia) y centro contraparte
  grupoTransferencia String? // mismo valor en la salida y la entrada ligadas
  centroDestinoId    String?
  centroDestino      Centro? @relation("MovimientoCentroDestino", fields: [centroDestinoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([centroId])
  @@index([campanaId])
  @@index([articuloId])
  @@index([tipo])
  @@index([grupoTransferencia])
  @@index([institucionId])
  @@index([estado])
}
