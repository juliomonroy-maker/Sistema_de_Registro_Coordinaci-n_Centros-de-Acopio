// Sistema de Registro y Coordinación de Centros de Acopio
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────  Usuarios / Roles  ─────────────────────────────

enum Rol {
  ADMIN // gestiona todo el sistema
  COORDINADOR // gestiona uno o varios centros y aprueba transferencias
  VOLUNTARIO // registra donaciones y actualiza inventario de su centro
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(VOLUNTARIO)
  activo       Boolean  @default(true)
  // Centro al que pertenece el usuario (coordinador/voluntario). Admin puede ser null.
  centroId     String?
  centro       Centro?  @relation(fields: [centroId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donacionesRegistradas Donacion[]      @relation("DonacionRegistradaPor")
  transferenciasCreadas Transferencia[] @relation("TransferenciaCreadaPor")

  @@index([centroId])
}

// ─────────────────────────────  Centros de Acopio  ────────────────────────────

enum EstadoCentro {
  ACTIVO
  INACTIVO
  LLENO // sin capacidad para recibir más insumos
}

model Centro {
  id          String       @id @default(cuid())
  nombre      String
  descripcion String?
  // Ubicación
  direccion   String
  ciudad      String
  estado      String // entidad federativa
  cp          String?
  latitud     Float?
  longitud    Float?
  // Contacto y operación
  telefono    String?
  email       String?
  responsable String?
  horario     String? // texto libre, ej. "Lun-Vie 9:00-18:00"
  capacidad   Int? // capacidad total estimada (unidades/m3), opcional
  situacion   EstadoCentro @default(ACTIVO)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  usuarios              Usuario[]
  inventario            Inventario[]
  donaciones            Donacion[]
  necesidades           Necesidad[]
  transferenciasOrigen  Transferencia[] @relation("TransferenciaOrigen")
  transferenciasDestino Transferencia[] @relation("TransferenciaDestino")

  @@index([situacion])
  @@index([ciudad])
}

// ─────────────────────────────  Catálogo de Insumos  ──────────────────────────

model Categoria {
  id        String    @id @default(cuid())
  nombre    String    @unique // Alimentos, Ropa, Medicamentos, Higiene, Agua...
  descripcion String?
  insumos   Insumo[]
  createdAt DateTime  @default(now())
}

model Insumo {
  id          String   @id @default(cuid())
  nombre      String
  unidad      String // kg, pza, litro, caja...
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  inventario       Inventario[]
  donacionItems    DonacionItem[]
  necesidades      Necesidad[]
  transferenciaItems TransferenciaItem[]

  @@unique([nombre, categoriaId])
  @@index([categoriaId])
}

// ─────────────────────────────  Inventario por Centro  ────────────────────────

model Inventario {
  id        String   @id @default(cuid())
  centroId  String
  centro    Centro   @relation(fields: [centroId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  cantidad  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([centroId, insumoId])
  @@index([centroId])
  @@index([insumoId])
}

// ─────────────────────────────  Donaciones (entradas)  ────────────────────────

model Donacion {
  id            String   @id @default(cuid())
  centroId      String
  centro        Centro   @relation(fields: [centroId], references: [id], onDelete: Cascade)
  donanteNombre String?
  donanteTel    String?
  notas         String?
  fecha         DateTime @default(now())
  registradaPorId String?
  registradaPor Usuario? @relation("DonacionRegistradaPor", fields: [registradaPorId], references: [id], onDelete: SetNull)

  items DonacionItem[]

  @@index([centroId])
  @@index([fecha])
}

model DonacionItem {
  id         String   @id @default(cuid())
  donacionId String
  donacion   Donacion @relation(fields: [donacionId], references: [id], onDelete: Cascade)
  insumoId   String
  insumo     Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  cantidad   Float

  @@index([donacionId])
}

// ─────────────────────────────  Necesidades por Centro  ───────────────────────

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Necesidad {
  id                String    @id @default(cuid())
  centroId          String
  centro            Centro    @relation(fields: [centroId], references: [id], onDelete: Cascade)
  insumoId          String
  insumo            Insumo    @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  cantidadRequerida Float
  prioridad         Prioridad @default(MEDIA)
  cubierta          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([centroId])
  @@index([prioridad])
}

// ─────────────────────────  Transferencias (coordinación)  ────────────────────

enum EstadoTransferencia {
  SOLICITADA
  APROBADA
  EN_TRANSITO
  COMPLETADA
  CANCELADA
}

model Transferencia {
  id         String              @id @default(cuid())
  origenId   String
  origen     Centro              @relation("TransferenciaOrigen", fields: [origenId], references: [id], onDelete: Restrict)
  destinoId  String
  destino    Centro              @relation("TransferenciaDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  estado     EstadoTransferencia @default(SOLICITADA)
  notas      String?
  creadaPorId String?
  creadaPor  Usuario?            @relation("TransferenciaCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items TransferenciaItem[]

  @@index([origenId])
  @@index([destinoId])
  @@index([estado])
}

model TransferenciaItem {
  id              String        @id @default(cuid())
  transferenciaId String
  transferencia   Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  insumoId        String
  insumo          Insumo        @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  cantidad        Float

  @@index([transferenciaId])
}
